# Copy to .env.local for local development, or set the same keys in the hosting panel
# (Hostinger hPanel → the Node.js app → Environment Variables).
#
# NEXT_PUBLIC_* values are baked in at BUILD time: after adding or changing them in hPanel,
# redeploy the app so it rebuilds. Both values are public (they appear in the page HTML).

# GA4 Measurement ID. Leave empty to disable Google Analytics (e.g. for local testing).
NEXT_PUBLIC_GA_ID=G-3STRRHF29J

# Site origin without trailing slash. Used for structured data (JSON-LD) and the www redirect.
# Falls back to "siteUrl" in data/config.json when empty.
NEXT_PUBLIC_SITE_URL=https://alantanijaya.com
